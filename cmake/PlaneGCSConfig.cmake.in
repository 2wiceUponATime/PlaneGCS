@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Eigen3)
# Isolated policy push: the consumer's own project may not set CMP0167
# (or may be on a CMake old enough that it doesn't exist), which would
# otherwise make Boost's lookup fail on installs that don't ship a
# BoostConfig.cmake (e.g. Homebrew). Scoping it to just this call means it
# doesn't affect anything else in the consumer's build.
cmake_policy(PUSH)
if(POLICY CMP0167)
    cmake_policy(SET CMP0167 OLD)
endif()
find_dependency(Boost COMPONENTS graph)
cmake_policy(POP)
find_dependency(fmt)

include("${CMAKE_CURRENT_LIST_DIR}/PlaneGCSTargets.cmake")

check_required_components(PlaneGCS)
